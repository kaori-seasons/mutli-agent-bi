# Chatbot UI Env config

# using your private ip
SERVER_HOST=http://172.31.19.161:5018

# 考虑到有可能部署到非aws机器，所以采用ak,sk来访问bedorck
ACCESS_KEY=ak
SECRET_ACCESS_KEY=sk


BUCKET_NAME=tx-text2sql2
DEV_MODEL=true



MAX_ROW_COUNT_RETURN=10

DEFAULT_MODEL=Amazon_bedrock
BEDROCK_MAX_TOKEN=51200
DEFAULT_REGION=us-east-1
# cognito
BACK_USER_POOL_REGION=us-east-2
BACK_USER_POOL_ID=us-east-2_ywDlltgf7
BACK_USER_CLIENT_ID=6d7ce73l62i002okft0aog9mst

RAG_SEARCH_LENGHT=1
EXAMPLE_FILE_NAME=demo/defaultDragonPrompt.json
PROMPT_FILE_NAME=demo/promptConfig.json
RAG_FILE_NAME=demo/ragSampleList.json

DEFAULT_MODEL_NAME=Amazon_bedrock
MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-image-v1

SQL_TEMPLATE_PATH=server/prompt_sqls

# 数据库信息
# 强烈建议数据库账户使用查询账户（不具备诸如insert delete等写操作权限)
# 支持多数据库，数据库信息之间使用逗号隔开
MYSQL_HOST=tx-db.cbore8wpy3mc.us-east-2.rds.amazonaws.com,tx-db.cbore8wpy3mc.us-east-2.rds.amazonaws.com
MYSQL_PORT=3306,3306
MYSQL_DATABASE=business,nitto
MYSQL_USER=demo,demo
MYSQL_PWD=Demo1234,Demo1234
# 数据库信息的key,一般用场景名称
MYSQL_KEY=demo,nitto
# 数据库信息的描述，一般是场景的简单描述
MYSQL_KEY_STR=demo,nitto

# 第一阶段本体：生成端可写、查询端可只读挂载同一目录
ONTOLOGY_STORE_PATH=/app/var/ontology
# 与资产发布端一致；每个数据源/资产集合使用独立命名空间
ONTOLOGY_NAMESPACE=default
# 旁路默认关闭；开启不改变 LLM/SQL 主链路
ONTOLOGY_SHADOW_ENABLED=false
ONTOLOGY_SHADOW_SAMPLE_RATE=0.1
ONTOLOGY_SHADOW_QUEUE_SIZE=128
ONTOLOGY_TOP_K=5
ONTOLOGY_REFRESH_SECONDS=5


# P0：必须显式授予源权限；sub 是 Cognito JWT sub，不是客户端用户名。
# AUTH_SOURCE_GRANTS={"group:analysts":["demo"],"sub:<cognito-sub>":["nitto"]}
AUTH_SOURCE_GRANTS={}
# 全局 Prompt 资产读取和索引更新限管理员，默认无人有此权限
AUTH_ADMIN_GROUPS=
# 多源部署中为每个 source_id 绑定允许的场景名称
# SOURCE_SCENARIOS={"demo":["订单"],"nitto":["汽车交付"]}
SOURCE_SCENARIOS={}
QUERY_DEADLINE_SECONDS=60
QUERY_MAX_SQL_CALLS=16
SQL_TIMEOUT_SECONDS=15
SQL_MAX_RESULT_ROWS=10000
SQL_MAX_RESULT_BYTES=8388608
QUERY_EXPORT_PATH=/app/var/exports
# 使用模型代理时，两端都需设置相同的 32 字符以上随机密钥
LLM_PROXY_TOKEN=
# 本地 python main.py 如需加载 .env，应显式设置 APP_ENV_FILE=.env

# P1 Registry v2：与原 v1 旁路目录独立；只支持单机本地 SQLite。
ONTOLOGY_REGISTRY_PATH=/app/var/registry/registry.sqlite3
ONTOLOGY_REGISTRY_NAMESPACE=default
# 默认保留 P0 查询路径。仅将已发布并验证模板的源加入灰度列表。
ONTOLOGY_QUERY_SOURCES=[]
